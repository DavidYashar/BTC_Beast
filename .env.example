# UTXO_Beast Environment Variables

# === Twitter/X (API v2 — OAuth 1.0a User Context) ===
# Get credentials from https://developer.twitter.com → Your App → Keys & Tokens
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_USERNAME=beast_btc15135

# === OpenAI ===
OPENAI_API_KEY=

# === Postgres (Render provides this via DATABASE_URL) ===
DATABASE_URL=

# === UTXO Platform API ===
UTXO_API_BASE_URL=https://utxo.fun/api/agent

# === UTXO Wallet (auto-provisioned on first boot) ===
# Network: MAINNET (default) or REGTEST
SPARK_AGENT_NETWORK=MAINNET
# 64-char hex key for wallet file encryption at rest:
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# === Operator Command Auth (HMAC signature) ===
OPERATOR_SECRET=

# === Server ===
PORT=10000

# === Beast Token (for self-promo tweets) ===
# Your $BEAST token address on UTXO Exchange. Self-promo cron skips if unset.
BEAST_TOKEN_ADDRESS=

# === Postgres TLS (Render provides this) ===
DATABASE_CA_CERT=

# === Tweeting Behavior ===
# true = crons start active on deploy. false = start paused (use /commands/start-tweeting to enable).
AUTO_TWEET=false

# === Configuration (cron expressions) ===
TRENDING_CRON=0 */4 * * *
MENTIONS_CRON=*/5 * * * *
ENGAGEMENT_CRON=*/15 * * * *
SELF_PROMO_CRON=0 14 * * *
S402_CRON=0 18 * * *
WALLET_CRON=0 22 * * *
CONTENT_CRON=0 */3 * * *
